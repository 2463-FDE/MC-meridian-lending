# Copy to .env and fill in with real values from your secret manager / host env.
# Do NOT commit a populated .env — it is git-ignored (was previously committed with
# live secrets; purged, see docs/security-remediation-2026-07.md).
POSTGRES_USER=meridian
POSTGRES_PASSWORD=
POSTGRES_DB=meridian
DB_HOST=postgres
DB_PORT=5432
DB_PASSWORD=
# DATABASE_URL must embed the SAME password you set in POSTGRES_PASSWORD above.
# Replace the placeholder below — a passwordless URL (meridian:@postgres) will pass
# `docker compose up` (only POSTGRES_PASSWORD is validated) but fail DB auth at
# runtime, and /health does not exercise the DB so the stack looks deployable.
DATABASE_URL=postgresql://meridian:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/meridian
REDIS_URL=redis://redis:6379/0
# Deployment environment. Leave as production (or any non-development value) for
# real deploys — synthetic credit scoring is HARD-REFUSED unless this is exactly
# "development", so a copied config can never approve loans on fake data.
ENVIRONMENT=production
CORE_BANKING_API_KEY=
EXPERIAN_KEY=
EXPERIAN_BASE_URL=https://api.experian.example.com/v2
# Synthetic-credit escape hatch — intentionally NOT enabled here. A copied
# .env.example must fail closed: with no EXPERIAN_KEY the decision endpoint
# returns 503 and /health reports unhealthy. To run the local demo WITHOUT a live
# bureau, use the demo override instead of editing this file:
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up
# (that override sets ENVIRONMENT=development + ALLOW_SYNTHETIC_CREDIT=1 — both
# gates are required, so neither one alone can enable it.)
PROCESSOR_API_KEY=
PROCESSOR_BASE_URL=https://api.cardprocessor.example.com
ORIGINATION_URL=http://origination-service:8001
SERVICING_URL=http://servicing-service:8002
KYC_URL=http://kyc-service:8003
DECISION_URL=http://decision-service:8004
DISCLOSURE_URL=http://disclosure-service:8005
PAYMENT_URL=http://payment-service:8006
SESSION_TTL_SECONDS=28800
# Anonymous resume session (ADR 0010 Phase B). The gateway keeps the continuation token
# server-side in Redis and hands the browser only an HttpOnly cookie holding an opaque id.
RESUME_TTL_SECONDS=604800
# Dedicated pepper(s) for hashing continuation tokens, SEPARATE from INTERNAL_SERVICE_TOKEN
# so rotating the service secret does not invalidate live resume tokens. Format:
# "version:secret,version:secret" (newest first); first is current, the rest accepted on
# verify until pre-rotation tokens expire (keep the old key >= RESUME_TTL, then drop it).
# REQUIRED outside development (PR #7 review): unset -> origination /health reports
# unhealthy and submit refuses to issue a token, rather than silently hashing new tokens with
# INTERNAL_SERVICE_TOKEN. Pre-existing rows hashed under the old service-token coupling are
# still accepted on VERIFY (until they expire) so setting this does not strand live sessions.
# The local demo (docker-compose.demo.yml, ENVIRONMENT=development) may leave it blank, where
# it falls back to INTERNAL_SERVICE_TOKEN for convenience only. The version name "legacy" is
# RESERVED for that fallback -- a key that claims it is ignored (rename it).
CONTINUATION_TOKEN_KEYS=
# The resume cookie is HttpOnly + SameSite=Strict always; set Secure (https-only) here.
# Keep true in real deploys; docker-compose overrides to false for the local http demo.
COOKIE_SECURE=true
# Browser origin allowed to send the credentialed (cookie) resume requests. Credentialed
# CORS forbids "*", so this must be the concrete portal origin.
PORTAL_ORIGIN=http://localhost:3000
# Shared secret marking a request as an internal service-to-service call. Required by
# every internal-only route: decision-service (POST /decisions, GET record), origination
# (monthly-debt remediation), kyc-service (POST /kyc/check), disclosure-service
# (POST /offers). The gateway strips any client-supplied X-Internal-Service so it can
# never be forged from outside; origination forwards it on its downstream calls. Set the
# SAME value for ALL services (compose loads .env for every service). Leave blank to fail
# closed (those routes then return 503). Host-env/secret-manager only — never commit a
# real value.
INTERNAL_SERVICE_TOKEN=
# Bound (seconds) for servicing's settlement-reconciliation duplicate-charge scan
# (spec docs/spec-observability-week7.md §D2(e)). Scoped in minutes, not days: it
# must catch an accidental retry/replay (seconds to low minutes apart) without
# false-flagging a legitimate next-cycle installment of the same amount (weeks
# apart). No committed default — reconciliation.py aborts rather than run the scan
# with a guessed bound.
DUPLICATE_SUSPECT_WINDOW_SECONDS=120
# Reconciliation cut-off, confirmed by the client 2026-08-14: the PROCESSOR-SETTLED
# date, read in UTC, matched within one calendar day either side
# (MATCH_TOLERANCE_DAYS in servicing's reconciliation.py). There is no variable to
# set — UTC is pinned on the servicing session in app/db.py and applied again where
# ledger rows are read, because payments.created_at is TIMESTAMPTZ and an unpinned
# session resolves its date in whatever timezone the database is set to. Stated here
# because the client asked for the rule to sit next to the configuration.

# Alert threshold for reconciliation (spec D4), in MINOR units. Set by the client on
# 2026-08-14: $5.00 aggregate per close, so 500. The alert fires when the window's
# PER-LOAN ABSOLUTE variance exceeds this — not the net, which cancels opposite-signed
# breaks (on the sample: -88882 net against 175318 absolute), and not the gross break
# value, which moves with the matching tolerance and would make the threshold shift
# whenever someone tuned a constant. Individual breaks appear in the report whatever
# their size; this gates the alert only. No committed default — reconciliation aborts
# (exit 2) and /health reports unhealthy rather than run against a guessed threshold.
RECONCILIATION_ALERT_THRESHOLD_MINOR=500
# Pepper for the decision-service SSN idempotency fingerprint (PR review). A reused
# Idempotency-Key arriving with a changed SSN must not replay a stale decision; the
# service stores only an HMAC of the SSN (never the SSN) and compares it.
#
# NO committed value — the digest is only non-reversible while the pepper is SECRET, and
# an SSN is a 9-digit space, so a public pepper here would let anyone with decision_events
# access brute-force the stored fingerprints back to SSNs. Blank (or a placeholder) is
# treated as NO pepper: the fingerprint is not persisted and, outside development, /health
# reports unhealthy. Set a real secret from a secret-manager in any non-dev deploy. The
# local demo supplies a dev-only value via docker-compose.demo.yml (development env).
DECISION_FINGERPRINT_PEPPER=
LOG_LEVEL=INFO
# --- LLM (Claude) ---
# DO NOT put the real key in the committed .env. Export it in your shell
# (`export CLAUDE_API_KEY=...`) or an untracked .env.local. docker-compose reads
# it from the host env; the app fails loud at boot if it is required and missing.
CLAUDE_API_KEY=
# Optional overrides (safe to commit — no secrets):
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_TIMEOUT=30
# CLAUDE_TOKEN_BUDGET=20000
#
# CLAUDE_PROVIDER=anthropic (default) | bedrock
# Set to `bedrock` to route through Amazon Bedrock instead of the direct
# Anthropic API — CLAUDE_API_KEY is then ignored, AWS credentials are used
# instead. Same host-env-only rule applies: AWS_BEARER_TOKEN_BEDROCK=... or the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION (prefer an IAM
# role over static keys). Never commit any of these.
# CLAUDE_PROVIDER=bedrock
# AWS_REGION=us-east-1
#
# --- LangSmith tracing (optional, off by default) ---
# Traces origination-service LLM calls to smith.langchain.com. By default the
# spans carry NO prompt or response content — only model, sizing params, token
# usage and cost. That is why a default trace shows latency and tokens with
# empty input/output. See app/llm/client.py / transport.py. Same host-env-only
# rule as CLAUDE_API_KEY: export LANGSMITH_API_KEY in your shell, never commit it.
# LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=2463-FDE
#
# Adds content to those spans: the prompt as sent (post-redaction) and the raw
# reply on llm.transport, plus the validated body on llm.complete. NON-PRODUCTION
# ONLY — build_request redacts identity PII but deliberately keeps the business
# facts the model needs (loan amount, income, employment tenure, purpose), so this
# ships customer lending content to a third-party vendor. Use synthetic applicants.
# Only the exact string "true" enables it; "1"/"yes"/"on" read as off.
# REQUIRES ENVIRONMENT=development (set above; it defaults to production).
# origination-service REFUSES TO START if this is true in any other environment,
# rather than silently ignoring it or silently exporting.
# It does NOT trace LangGraph node state — see disclosure_coordinator.py.
# LLM_TRACE_CONTENT=true
#
# --- Policy retrieval (ADR 0019) ---
# Minimum match score before the assistant quotes a policy passage to an officer.
# Unset = every policy question abstains ("no policy match"), which is the safe
# state, not a broken one. The value below is what `rag_eval` calibrated for the
# committed 9-chunk corpus with the default TF-IDF embedder — see the threshold
# line in rag_eval/eval_report.md. It is NOT a code default: change the corpus or
# set RAG_EMBEDDER=bedrock and this number no longer applies, so re-run
# `python3 -m rag_eval.run` and use the threshold it prints.
POLICY_RETRIEVAL_MIN_SCORE=0.1609
